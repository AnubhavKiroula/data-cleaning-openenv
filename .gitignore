# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
develop-eggs/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Run artifacts ----
logs/
*.log
scratch/
graphify-out/
.graphifyignore

# ---- Data ----
# The 3.5 MB UCI CSV is tracked so the notebook and CI are self-contained.
# The redundant .xlsx / .zip copies of the same data are not.
data/air_quality/*.xlsx
data/air_quality/*.zip
# Legacy web-app upload directory.
data/uploads/

# ---- Model checkpoints ----
# The reported RL-Cleanse checkpoints are tracked (~95 KB each) so that the
# notebook reproduces the published multi-seed table on a fresh clone. Legacy
# tabular checkpoints from the pre-pivot application are not.
models/*.pt
!models/dqn_iot_stream_best.pt
!models/dqn_iot_stream_final.pt
!models/dqn_iot_stream_best_seed*.pt
models/dqn_easy_*
# Per-seed training logs duplicate what dqn_iot_stream_seed_summary.json records.
models/dqn_iot_stream_metrics_seed*.json
models/dqn_easy_*_metrics.json

# ---- Plots ----
# Track only the three figures the write-ups cite.
plots/dqn_training_curves_easy_*.png
plots/dqn_iot_training_curves_seed*.png

# ---- Reports ----
reports/dqn_training_report_easy_*.json

# ---- Legacy application state ----
*.db
data_cleaning.db
node_modules/
