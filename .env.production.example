# Production Environment Variables
# Copy this file to .env.production and fill in the actual values

# ============ DATABASE ============
POSTGRES_DB=data_cleaning
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-postgres-password-here

# ============ APPLICATION ============
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============ REDIS ============
REDIS_URL=redis://redis:6379/0

# ============ BACKEND ============
DATABASE_URL=postgresql://admin:your-secure-postgres-password-here@postgres:5432/data_cleaning
JWT_SECRET=your-secret-jwt-key-here-generate-with-python-secrets

# ============ FRONTEND ============
# Example: https://01ammu-data-cleaning-openenv.hf.space/api
# Or: http://backend:8000/api (for internal Docker Compose)
VITE_API_BASE_URL=/api

# ============ REGISTRY ============
# For GHCR deployment, set this to your GitHub username
REGISTRY_OWNER=yourgithubusername

# ============ OPTIONAL: HuggingFace Spaces ============
# If deploying to HF Spaces, set the Space URL
HF_SPACE_URL=https://yourusername-data-cleaning-openenv.hf.space
